FROM debian:13

LABEL org.opencontainers.image.source=https://github.com/SakanaAI/ALE-Bench

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    DEBCONF_NONINTERACTIVE_SEEN=true \
    TZ=Etc/UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    DOTNET_EnableWriteXorExecute=0

ENV LD_LIBRARY_PATH= \
    LIBRARY_PATH= \
    CPATH=

ARG BASH_VERSION=5.3
ARG FISH_VERSION=4.0.2
ARG PERL_VERSION=5.38.2
ARG GCC_VERSION=15.2.0
ARG RUST_VERSION=1.89.0
ARG GO_VERSION=1.25.1
ARG PYTHON_VERSION=3.13.7
ARG PYPY_VERSION=7.3.20
ARG NODE_VERSION=22.19.0
ARG TYPESCRIPT_VERSION=5.9.2
ARG OCAML_SWITCH=5.3.0+flambda
ARG DOTNET_SDK_VERSION=9.0.304
ARG LEAN_VERSION=v4.22.0

ARG BOOST_VERSION=1.88.0
ARG ACL_VERSION=1.6
ARG ABSEIL_VERSION=20250512.1
ARG IMMER_VERSION=0.8.1
ARG UNORDERED_DENSE_VERSION=4.5.0
ARG RANGE_V3_VERSION=0.12.0
ARG Z3_VERSION=4.15.2
ARG LIBTORCH_VERSION=2.8.0
ARG LIGHTGBM_VERSION=4.6.0
ARG ORTOOLS_VERSION=9.14
ARG FPM_VERSION=0.10.1
ARG FORTRAN_STDLIB_VERSION=0.7.0

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates curl wget git gnupg dirmngr time \
      ansifilter xz-utils unzip bzip2 tar file patch ripgrep \
      build-essential cmake gdb lcov ninja-build pkg-config \
      bison flex texinfo gawk rsync zlib1g-dev libzstd-dev \
      libgmp-dev libmpfr-dev libmpc-dev libisl-dev \
      libssl-dev libbz2-dev libreadline-dev libsqlite3-dev libncurses5-dev libncursesw5-dev \
      libffi-dev liblzma-dev uuid-dev tk-dev llvm-bolt libbolt-19-dev \
      libgdbm-dev libgdbm-compat-dev libnss3-dev libexpat1-dev \
      libopenblas-dev liblapack-dev libicu-dev \
      python3 python3-pip python3-venv python3-dev fypp python3-joblib \
      gfortran gfortran-14 libstdc++-14-dev libeigen3-dev \
      opam gettext libpcre2-dev libgeos-dev meson; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    mkdir -p /workdir

WORKDIR /workdir

RUN set -eux; \
    cp -Trf /usr/include/eigen3 /usr/local/include

# ---- Bash 5.3 ----
RUN set -eux; \
    mkdir -p /tmp/bash; \
    cd /tmp/bash; \
    curl -fsSL "https://ftp.gnu.org/gnu/bash/bash-${BASH_VERSION}.tar.gz" -o bash.tar.gz; \
    tar -xzf bash.tar.gz; \
    cd "bash-${BASH_VERSION}"; \
    ./configure --enable-largefile --without-bash-malloc; \
    make -j"$(nproc)"; \
    make install; \
    rm -rf /tmp/bash

# ---- Fish 4.0.2 ----
RUN set -eux; \
    mkdir -p /tmp/fish; \
    cd /tmp/fish; \
    curl -fsSL "https://github.com/fish-shell/fish-shell/releases/download/${FISH_VERSION}/fish-${FISH_VERSION}.tar.xz" -o fish.tar.xz; \
    tar -xJf fish.tar.xz; \
    cd "fish-${FISH_VERSION}"; \
    cmake -S . -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local; \
    cmake --build build; \
    cmake --install build; \
    fish --version; \
    rm -rf /tmp/fish

# ---- Perl 5.38.2 ----
RUN set -eux; \
    mkdir -p /tmp/perl; \
    cd /tmp/perl; \
    curl -fsSL "https://www.cpan.org/src/5.0/perl-${PERL_VERSION}.tar.xz" -o perl.tar.xz; \
    tar -xJf perl.tar.xz; \
    cd "perl-${PERL_VERSION}"; \
    sh Configure -des -Dprefix=/usr/local; \
    make -j"$(nproc)"; \
    make install; \
    perl -e 'print "$]\\n"'; \
    rm -rf /tmp/perl

# ---- C++23 (GCC 15.2.0 + AtCoder 2025-10 libraries) ----
ENV GCC_DIR=/opt/gcc-${GCC_VERSION}
RUN set -eux; \
    mkdir -p /tmp/gcc-src; \
    cd /tmp/gcc-src; \
    curl -fsSL "https://ftp.gnu.org/gnu/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz" -o gcc.tar.xz; \
    tar -xJf gcc.tar.xz; \
    cd "gcc-${GCC_VERSION}"; \
    ./contrib/download_prerequisites; \
    mkdir -p build; \
    cd build; \
    ../configure \
      --prefix="${GCC_DIR}" \
      --enable-languages=c++ \
      --disable-bootstrap \
      --disable-multilib \
      --disable-libsanitizer \
      --disable-checking \
      --disable-nls \
      --disable-gcov \
      --disable-libada \
      --disable-libgm2; \
    make -j"$(nproc)"; \
    make install-strip; \
    echo "${GCC_DIR}/lib64" > /etc/ld.so.conf.d/gcc-${GCC_VERSION}.conf; \
    echo "${GCC_DIR}/lib" >> /etc/ld.so.conf.d/gcc-${GCC_VERSION}.conf; \
    ldconfig; \
    rm -rf /tmp/gcc-src

ENV PATH="${GCC_DIR}/bin:${PATH}" \
    LD_LIBRARY_PATH="${GCC_DIR}/lib64:${GCC_DIR}/lib:${LD_LIBRARY_PATH}"

RUN set -eux; \
    mkdir -p /tmp/boost; \
    cd /tmp/boost; \
    curl -fsSL "https://archives.boost.io/release/${BOOST_VERSION}/source/boost_${BOOST_VERSION//./_}.tar.bz2" -o boost.tar.bz2; \
    tar -xjf boost.tar.bz2; \
    cd "boost_${BOOST_VERSION//./_}"; \
    ./bootstrap.sh \
      --with-toolset=gcc \
      --without-libraries=mpi,graph_parallel,python \
      --prefix=/usr/local; \
    ./b2 \
      toolset=gcc \
      link=static \
      threading=single \
      variant=release \
      cflags="-w" \
      cxxflags="-std=gnu++23 -w" \
      -j"$(nproc)" -d0 \
      install; \
    rm -rf /tmp/boost

RUN set -eux; \
    mkdir -p /tmp/acl; \
    cd /tmp/acl; \
    curl -fsSL "https://github.com/atcoder/ac-library/archive/refs/tags/v${ACL_VERSION}.tar.gz" -o acl.tar.gz; \
    tar -xzf acl.tar.gz; \
    cp -r "ac-library-${ACL_VERSION}/atcoder" /usr/local/include/; \
    rm -rf /tmp/acl

RUN set -eux; \
    mkdir -p /tmp/abseil; \
    cd /tmp/abseil; \
    curl -fsSL "https://github.com/abseil/abseil-cpp/archive/refs/tags/${ABSEIL_VERSION}.tar.gz" -o abseil.tar.gz; \
    tar -xzf abseil.tar.gz; \
    cd "abseil-cpp-${ABSEIL_VERSION}"; \
    cmake -S . -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DABSL_ENABLE_INSTALL=ON \
      -DABSL_PROPAGATE_CXX_STD=ON \
      -DABSL_USE_SYSTEM_INCLUDES=ON \
      -DCMAKE_CXX_FLAGS="-fPIC -std=gnu++23 -w"; \
    cmake --build build; \
    cmake --install build; \
    rm -rf /tmp/abseil

RUN set -eux; \
    mkdir -p /tmp/immer; \
    cd /tmp/immer; \
    curl -fsSL "https://github.com/arximboldi/immer/archive/refs/tags/v${IMMER_VERSION}.tar.gz" -o immer.tar.gz; \
    tar -xzf immer.tar.gz; \
    cp -Trf "immer-${IMMER_VERSION}/immer" /usr/local/include/immer; \
    rm -rf /tmp/immer

RUN set -eux; \
    mkdir -p /tmp/unordered_dense; \
    cd /tmp/unordered_dense; \
    curl -fsSL "https://github.com/martinus/unordered_dense/archive/refs/tags/v${UNORDERED_DENSE_VERSION}.tar.gz" -o ud.tar.gz; \
    tar -xzf ud.tar.gz; \
    cd "unordered_dense-${UNORDERED_DENSE_VERSION}"; \
    cmake -S . -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local; \
    cmake --build build; \
    cmake --install build; \
    rm -rf /tmp/unordered_dense

RUN set -eux; \
    mkdir -p /tmp/range-v3; \
    cd /tmp/range-v3; \
    curl -fsSL "https://github.com/ericniebler/range-v3/archive/refs/tags/${RANGE_V3_VERSION}.tar.gz" -o range-v3.tar.gz; \
    tar -xzf range-v3.tar.gz; \
    cp -r "range-v3-${RANGE_V3_VERSION}/include/range" /usr/local/include/; \
    cp -r "range-v3-${RANGE_V3_VERSION}/include/meta" /usr/local/include/; \
    cp -r "range-v3-${RANGE_V3_VERSION}/include/concepts" /usr/local/include/; \
    rm -rf /tmp/range-v3

RUN set -eux; \
    mkdir -p /tmp/z3; \
    cd /tmp/z3; \
    curl -fsSL "https://github.com/Z3Prover/z3/archive/refs/tags/z3-${Z3_VERSION}.tar.gz" -o z3.tar.gz; \
    tar -xzf z3.tar.gz; \
    cd z3-*; \
    cmake -S . -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DZ3_BUILD_TEST_EXECUTABLES=OFF \
      -DZ3_BUILD_PYTHON_BINDINGS=OFF; \
    cmake --build build; \
    cmake --install build; \
    rm -rf /tmp/z3

RUN set -eux; \
    curl -fsSL "https://download.pytorch.org/libtorch/cpu/libtorch-shared-with-deps-${LIBTORCH_VERSION}%2Bcpu.zip" -o /tmp/libtorch.zip; \
    unzip -q /tmp/libtorch.zip -d /tmp; \
    rm -f /tmp/libtorch/lib/libprotobuf.a /tmp/libtorch/lib/libprotobuf-lite.a /tmp/libtorch/lib/libprotoc.a; \
    cp -Trf /tmp/libtorch/include /usr/local/include; \
    cp -Trf /tmp/libtorch/lib /usr/local/lib; \
    ldconfig; \
    rm -rf /tmp/libtorch.zip /tmp/libtorch

RUN set -eux; \
    mkdir -p /tmp/lightgbm; \
    cd /tmp/lightgbm; \
    curl -fsSL "https://github.com/microsoft/LightGBM/releases/download/v${LIGHTGBM_VERSION}/lightgbm-${LIGHTGBM_VERSION}.tar.gz" -o lightgbm.tar.gz; \
    mkdir -p lightgbm-src; \
    tar -xzf lightgbm.tar.gz -C lightgbm-src --strip-components=1; \
    cd lightgbm-src; \
    rm -rf ./lightgbm ./external_libs/eigen; \
    mkdir -p build; \
    cd build; \
    cmake -G Ninja \
      -DBUILD_CLI:BOOL=OFF \
      -DBUILD_STATIC_LIB=ON \
      -DUSE_HOMEBREW_FALLBACK=OFF \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_CXX_FLAGS="-std=gnu++23 -w -fopenmp" \
      ..; \
    cmake --build . --target install; \
    rm -rf /tmp/lightgbm

RUN set -eux; \
    mkdir -p /tmp/or-tools; \
    cd /tmp/or-tools; \
    curl -fsSL "https://github.com/google/or-tools/archive/refs/tags/v${ORTOOLS_VERSION}.tar.gz" -o or-tools.tar.gz; \
    tar -xzf or-tools.tar.gz; \
    cd or-tools-*; \
    mkdir -p build; \
    cd build; \
    cmake -G Ninja \
      -DBUILD_CXX:BOOL=ON \
      -DBUILD_BZip2:BOOL=ON -DBUILD_ZLIB:BOOL=ON -DBUILD_Protobuf:BOOL=ON -DBUILD_re2:BOOL=ON \
      -DUSE_COINOR:BOOL=ON -DBUILD_CoinUtils:BOOL=ON -DBUILD_Osi:BOOL=ON -DBUILD_Clp:BOOL=ON -DBUILD_Cgl:BOOL=ON -DBUILD_Cbc:BOOL=ON \
      -DUSE_GLPK:BOOL=ON -DBUILD_GLPK:BOOL=ON \
      -DUSE_HIGHS:BOOL=ON -DBUILD_HIGHS:BOOL=ON \
      -DUSE_SCIP:BOOL=ON -DBUILD_SCIP:BOOL=ON -DBUILD_soplex:BOOL=ON -DBUILD_Boost:BOOL=ON \
      -DBUILD_SAMPLES:BOOL=OFF -DBUILD_EXAMPLES:BOOL=OFF \
      -DBUILD_TESTING:BOOL=OFF \
      -DCMAKE_PREFIX_PATH=/usr/local \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DBUILD_SHARED_LIBS:BOOL=OFF \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH:BOOL=ON \
      -DCMAKE_CXX_FLAGS="-std=gnu++23 -w" \
      ..; \
    cmake --build . --config Release; \
    cmake --build . --config Release --target install; \
    rm -rf /tmp/or-tools

ENV CPATH="/usr/local/include/torch/csrc/api/include:${CPATH}"

# ---- Rust 1.89.0 ----
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo
ENV PATH="${CARGO_HOME}/bin:${PATH}"

RUN set -eux; \
    curl -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh; \
    sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain "${RUST_VERSION}"; \
    cargo -vV; \
    [ "$(command -v cargo)" = "${CARGO_HOME}/bin/cargo" ]; \
    [ "$(cargo -vV | sed -n 's/release: \(.*\)/\1/p')" = "${RUST_VERSION}" ]; \
    rm -f /tmp/rustup-init.sh

COPY ./rust_202510_config.toml /workdir/.cargo/config.toml
COPY ./rust_202510_Cargo.toml /workdir/Cargo.toml
COPY ./rust_202510_Cargo.lock /workdir/Cargo.lock

RUN set -eux; \
    mkdir -p /workdir/src; \
    echo "fn main() {}" > /workdir/src/main.rs; \
    cargo build -vv --release; \
    rm -f /workdir/target/release/main

# ---- Go 1.25.1 ----
RUN set -eux; \
    curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tgz; \
    rm -rf /opt/go; \
    tar -C /opt -xzf /tmp/go.tgz; \
    rm -f /tmp/go.tgz; \
    mkdir -p /opt/go-work
ENV GOROOT=/opt/go \
    GOPATH=/opt/go-work
ENV PATH="${GOROOT}/bin:${PATH}"

# Prefetch Go modules used by AtCoder
RUN set -eux; \
    cd /workdir; \
    go mod init atcoder.jp/golang; \
    go get \
      github.com/emirpasic/gods@v1.18.1 \
      gonum.org/v1/gonum@v0.16.0 \
      github.com/liyue201/gostl@v1.2.0 \
      github.com/benbjohnson/immutable@v0.4.3 \
      golang.org/x/exp@v0.0.0-20250711185948-6ae5c78190dc \
      github.com/monkukui/ac-library-go@2caa314afb5ad142f497cf3c1a5c7d5740184c0d

# ---- CPython 3.13.7 ----
# error if not libbolt_rt_instr.a in /usr/lib
RUN set -eux; \
    mkdir -p /tmp/python-src; \
    cd /tmp/python-src; \
    curl -fsSL "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tar.xz" -o "Python-${PYTHON_VERSION}.tar.xz"; \
    tar -xf "Python-${PYTHON_VERSION}.tar.xz"; \
    ln -sf /usr/lib/llvm-19/lib/libbolt_rt_instr.a /usr/lib/libbolt_rt_instr.a; \
    cd "Python-${PYTHON_VERSION}"; \
    ./configure \
      --enable-optimizations \
      --with-lto=full \
      --with-strict-overflow \
      --enable-bolt \
      --prefix=/usr/local \
      --enable-shared \
      --with-ensurepip=install \
      CC=/usr/bin/gcc CXX=/usr/bin/g++; \
    make -j"$(nproc)" CC=/usr/bin/gcc CXX=/usr/bin/g++; \
    make altinstall CC=/usr/bin/gcc CXX=/usr/bin/g++; \
    ldconfig; \
    rm -rf /tmp/python-src

COPY ./python_202510_freeze.txt /tmp/freeze.txt
RUN set -eux; \
    python3.13 -m pip install --no-cache-dir -U pip setuptools; \
    python3.13 -m pip install --no-cache-dir -r /tmp/freeze.txt --no-warn-script-location; \
    python3.13 -m pip install --no-cache-dir torch==2.8.0+cpu --index-url https://download.pytorch.org/whl/cpu --no-warn-script-location; \
    wget -q -O /tmp/numba.tar.gz https://files.pythonhosted.org/packages/1c/a0/e21f57604304aa03ebb8e098429222722ad99176a4f979d34af1d1ee80da/numba-0.61.2.tar.gz; \
    mkdir -p /tmp/numba; \
    tar -C /tmp/numba --strip-components=1 -xf /tmp/numba.tar.gz; \
    cd /tmp/numba; \
    sed -i 's/ext_cuda_extras, //' setup.py; \
    rm -rf numba/cuda; \
    python3.13 -m pip install --no-cache-dir .; \
    rm -rf /tmp/numba; \
    rm -f /tmp/freeze.txt /tmp/numba.tar.gz;

# ---- PyPy 3.11-v7.3.20 ----
RUN set -eux; \
    cd /tmp; \
    curl -fsSL "https://downloads.python.org/pypy/pypy3.11-v${PYPY_VERSION}-linux64.tar.bz2" -o pypy.tar.bz2; \
    tar -xjf pypy.tar.bz2; \
    cd "pypy3.11-v${PYPY_VERSION}-linux64"; \
    ./bin/pypy3 -m ensurepip; \
    ./bin/pip3 install --upgrade pip; \
    ./bin/pip3 install --break-system-packages \
      "numpy==2.3.2" \
      "scipy==1.15.3" \
      "networkx==3.5" \
      "sympy==1.14.0" \
      "sortedcontainers==2.4.0" \
      "more-itertools==10.7.0" \
      "shapely==2.1.1" \
      "bitarray==3.6.0" \
      "PuLP==3.2.2" \
      "mpmath==1.3.0" \
      "pandas==2.3.1" \
      "z3-solver==4.15.1.0" \
      "scikit-learn==1.7.1" \
      "cppyy==3.5.0" \
      "acl-cpp-python==0.6.2" \
      "git+https://github.com/not522/ac-library-python@27fdbb71cd0d566bdeb12746db59c9d908c6b5d5"; \
    cp -a ./bin/* /usr/local/bin/; \
    cp -a ./include/* /usr/local/include/; \
    cp -a ./lib/* /usr/local/lib/; \
    ldconfig; \
    rm -rf /tmp/pypy.tar.bz2 "/tmp/pypy3.11-v${PYPY_VERSION}-linux64"

# ---- Node.js 22.19.0 + JavaScript/TypeScript libs ----
COPY ./node_202510_node.sh /usr/local/bin/node.sh
RUN set -eux; \
    curl -fsSL "https://nodejs.org/download/release/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o /tmp/node.tar.xz; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
    rm -f /tmp/node.tar.xz; \
    ln -sf /usr/local/lib/node_modules /node_modules; \
    npm i -g \
      "ac-library-js@0.1.1" \
      "data-structure-typed@2.0.4" \
      "immutable@5.1.3" \
      "lodash@4.17.21" \
      "mathjs@14.7.0" \
      "tstl@3.0.0" \
      "typescript@${TYPESCRIPT_VERSION}" \
      "@types/node@22.18.1" \
      "@types/lodash@4.17.20"; \
    chmod +x /usr/local/bin/node.sh; \
    cp /usr/local/bin/node.sh /workdir/node.sh; \
    chmod +x /workdir/node.sh

ENV NODE_PATH=/usr/local/lib/node_modules

# ---- Fortran (gfortran-14.2.0 + stdlib v0.7.0) ----
RUN set -eux; \
    curl -fsSL "https://github.com/fortran-lang/fpm/releases/download/v${FPM_VERSION}/fpm-${FPM_VERSION}-linux-x86_64" -o /usr/local/bin/fpm; \
    chmod +x /usr/local/bin/fpm

RUN set -eux; \
    mkdir -p /tmp/fortran; \
    cd /tmp/fortran; \
    git clone --depth 1 --branch "v${FORTRAN_STDLIB_VERSION}" https://github.com/fortran-lang/stdlib.git; \
    cd stdlib; \
    printf '\n[install]\nlibrary = true\n' >> fpm.toml; \
    python3 config/fypp_deployment.py; \
    FPM_FC=gfortran FPM_FFLAGS="-O2 -cpp -std=f2023" fpm build --profile release; \
    FPM_FC=gfortran FPM_FFLAGS="-O2 -cpp -std=f2023" fpm install --profile release --prefix /usr/local; \
    ldconfig; \
    rm -rf /tmp/fortran

COPY ./fortran_202510_Main.f90 /workdir/Main.f90
RUN set -eux; \
    cd /workdir; \
    git clone --depth 1 https://github.com/ue1221/ac-library-fortran.git acl; \
    gfortran -I/usr/local/include -O2 -cpp -ffree-line-length-none -std=f2023 Main.f90 -lstdlib; \
    ./a.out; \
    rm -f Main.f90 a.out mod_union_find.mod

# ---- OCaml 5.3.0+flambda ----
ENV OPAMROOT=/opt/opam \
    OPAMYES=1 \
    OPAMSWITCH=${OCAML_SWITCH} \
    PATH="/opt/opam/${OCAML_SWITCH}/bin:${PATH}"

RUN set -eux; \
    opam init -a --bare --disable-sandboxing --no-setup --shell=bash; \
    opam switch create "${OCAML_SWITCH}" ocaml-variants.5.3.0+options ocaml-option-flambda.1; \
    eval "$(opam env --switch=${OCAML_SWITCH})"; \
    opam install \
      "num=1.6" \
      "zarith=1.14" \
      "containers=3.16" \
      "core=v0.17.1" \
      "iter=1.9" \
      "batteries=3.9.0"; \
    opam clean -a -c -s --logs

# ---- .NET SDK 9.0.304 ----
ENV DOTNET_ROOT=/opt/dotnet \
    PATH=/opt/dotnet:/opt/dotnet/tools:${PATH} \
    DOTNET_CLI_TELEMETRY_OPTOUT=1

RUN set -eux; \
    curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh; \
    bash /tmp/dotnet-install.sh --version "${DOTNET_SDK_VERSION}" --install-dir /opt/dotnet; \
    rm -f /tmp/dotnet-install.sh; \
    dotnet --info > /dev/null

COPY ./csharp_202510_Main.csproj /workdir/Main.csproj
COPY ./csharp_202510_Main.cs /workdir/Main.cs
COPY ./csharp_202510_packages.lock.json /workdir/packages.lock.json
RUN set -eux; \
    cd /workdir; \
    dotnet restore --locked-mode; \
    dotnet publish -c Release -o publish --no-restore -v n; \
    rm -f publish/Main Main.cs; \
    rm -rf /workdir/bin /workdir/obj

# ---- Lean 4.22.0 ----
ENV PATH="/root/.elan/bin:${PATH}"
RUN set -eux; \
    curl -fsSL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh -o /tmp/elan-init.sh; \
    chmod +x /tmp/elan-init.sh; \
    /tmp/elan-init.sh -y --default-toolchain "leanprover/lean4:${LEAN_VERSION}"; \
    rm -f /tmp/elan-init.sh; \
    cd /workdir; \
    lake new atcoder exe; \
    cd atcoder; \
