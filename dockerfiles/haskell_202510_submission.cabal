                  kan-extensions ^>=5.2.7,
                  lens ^>=5.3.5,
                  linear-base ^>=0.5.0,
                  list-t ^>=1.0.5.7,
                  massiv ^>=1.0.5.0,
                  megaparsec ^>=9.7.0,
                  monad-memo ^>=0.5.4,
                  mono-traversable ^>=1.0.21.0,
                  mtl ^>=2.3.1,
