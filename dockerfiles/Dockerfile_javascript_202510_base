FROM debian:13

LABEL org.opencontainers.image.source=https://github.com/SakanaAI/ALE-Bench

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    DEBCONF_NONINTERACTIVE_SEEN=true \
    TZ=Etc/UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

ARG NODE_VERSION=22.19.0

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl time; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workdir

COPY ./node_202510_node.sh /usr/local/bin/node.sh
RUN set -eux; \
    curl -fsSL "https://nodejs.org/download/release/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o /tmp/node.tar.xz; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
    rm -f /tmp/node.tar.xz; \
    ln -sf /usr/local/lib/node_modules /node_modules; \
    npm i -g \
      "ac-library-js@0.1.1" \
      "data-structure-typed@2.0.4" \
      "immutable@5.1.3" \
      "lodash@4.17.21" \
      "mathjs@14.7.0" \
      "tstl@3.0.0"; \
    chmod +x /usr/local/bin/node.sh; \
    cp /usr/local/bin/node.sh /workdir/node.sh; \
    chmod +x /workdir/node.sh

ENV NODE_PATH=/usr/local/lib/node_modules
