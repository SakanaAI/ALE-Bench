FROM debian:13

LABEL org.opencontainers.image.source=https://github.com/SakanaAI/ALE-Bench

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    DEBCONF_NONINTERACTIVE_SEEN=true \
    TZ=Etc/UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

ARG BASH_VERSION=5.3

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates curl build-essential time; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workdir

RUN set -eux; \
    mkdir -p /tmp/bash; \
    cd /tmp/bash; \
    curl -fsSL "https://ftp.gnu.org/gnu/bash/bash-${BASH_VERSION}.tar.gz" -o bash.tar.gz; \
    tar -xzf bash.tar.gz; \
    cd "bash-${BASH_VERSION}"; \
    ./configure --enable-largefile --without-bash-malloc; \
    make -j"$(nproc)"; \
    make install; \
    rm -rf /tmp/bash
