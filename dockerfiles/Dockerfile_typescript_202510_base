FROM ubuntu:24.04

LABEL org.opencontainers.image.source=https://github.com/SakanaAI/ALE-Bench

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    DEBCONF_NONINTERACTIVE_SEEN=true \
    TZ=Etc/UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

ARG TARGETARCH
ARG TARGETVARIANT
ARG NODE_VERSION=22.19.0
ARG TYPESCRIPT_VERSION=5.9.2

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl ansifilter xz-utils time; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workdir

COPY ./node_202510_node.sh /workdir/node.sh

RUN set -eux; \
    arch="${TARGETARCH:-$(uname -m)}"; \
    variant="${TARGETVARIANT:-}"; \
    case "${arch}" in \
        amd64|x86_64) node_arch="x64" ;; \
        arm64|aarch64) node_arch="arm64" ;; \
        ppc64le) node_arch="ppc64le" ;; \
        s390x) node_arch="s390x" ;; \
        arm) \
            case "${variant}" in \
                v7|/v7|'') node_arch="armv7l" ;; \
                *) echo "unsupported TARGETVARIANT for arm: ${variant}" >&2; exit 1 ;; \
            esac ;; \
        *) echo "unsupported architecture for Node.js: ${arch}" >&2; exit 1 ;; \
    esac; \
    curl -fsSLo /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"; \
    tar -C /usr/local --strip-components=1 -xf /tmp/node.tar.xz --wildcards '*/bin' '*/share' '*/lib' '*/include'; \
    rm -f /tmp/node.tar.xz; \
    ln -sf /usr/local/lib/node_modules /node_modules; \
    npm i -g \
        "ac-library-js@0.1.1" \
        "data-structure-typed@2.0.4" \
        "immutable@5.1.3" \
        "lodash@4.17.21" \
        "mathjs@14.7.0" \
        "tstl@3.0.0" \
        "typescript@${TYPESCRIPT_VERSION}" \
        "@types/node@22.18.1" \
        "@types/lodash@4.17.20"; \
    chmod +x /workdir/node.sh

ENV NODE_PATH=/usr/local/lib/node_modules
